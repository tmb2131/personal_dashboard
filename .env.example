# --- Database (Neon Postgres) ---
# Create a project at https://neon.tech, copy the pooled connection string.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Auth.js / Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#                          https://<your-vercel-domain>/api/auth/callback/google
# Required scopes: openid, email, profile,
#   https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Run: openssl rand -base64 32
AUTH_SECRET=

# Email allowed to sign in. Anyone else is rejected.
ALLOWED_EMAIL=thomas.brosens@gmail.com

# --- Notion ---
# Create an internal integration at https://www.notion.so/my-integrations
# Share the To-Dos and Categories databases (or their parent page) with this integration.
NOTION_TOKEN=
# Data source IDs (already discovered from the workspace):
NOTION_TODOS_DATA_SOURCE_ID=e1123787-f0bd-4cbe-a6f8-73b5dfe67bd5
NOTION_CATEGORIES_DATA_SOURCE_ID=69b5b17a-c16b-48d8-a19c-a1bd0e394424
# Optional, set after configuring webhook subscription:
NOTION_WEBHOOK_SECRET=

# --- Todoist ---
# Settings -> Integrations -> Developer -> "Copy API token"
TODOIST_TOKEN=
# Set after registering a webhook in the Todoist app console
TODOIST_WEBHOOK_SECRET=

# --- Google Calendar ---
# Comma-separated calendar IDs to watch. Defaults to primary + Sriya.
GCAL_CALENDAR_IDS=thomas.brosens@gmail.com,sriya.sundaresan@gmail.com

# --- App ---
# Used for signing webhook callback URLs. Must match deployed origin.
APP_URL=http://localhost:3000
